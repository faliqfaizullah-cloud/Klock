<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg" android:clipToOutline="true">
  <ImageView android:id="@+id/dial" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"/>
  <TextClock android:id="@+id/lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp"
    android:format12Hour="a" android:format24Hour="EEE" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF8A8A92"/>
  <TextClock android:id="@+id/hourClk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="27dp"
    android:format12Hour="hh" android:format24Hour="HH" android:textSize="32sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/w_ink"/>
  <TextClock android:id="@+id/timeClk" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
    android:format12Hour="hh:mm" android:format24Hour="HH:mm" android:textSize="40sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:textColor="@color/w_ink"/>
</FrameLayout>
